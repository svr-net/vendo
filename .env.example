# ---------- Core ----------
PORT=3000
# Public URL of this app. Used for OAuth redirect URIs and for serving uploaded
# creatives to platforms that fetch media by URL (TikTok, Pinterest).
PUBLIC_BASE_URL=http://localhost:3000
# 32+ random characters. Encrypts stored platform tokens and signs sessions.
APP_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/vendo.db

# ---------- Meta (Facebook & Instagram) Marketing API ----------
# https://developers.facebook.com/apps -> Create app (type "Business") -> add "Marketing API"
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0

# ---------- Google Ads API ----------
# OAuth client: https://console.cloud.google.com/apis/credentials (type "Web application")
# Developer token: Google Ads Manager account -> Tools -> API Center
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: manager (MCC) account id without dashes when accessing client accounts through it
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# ---------- TikTok for Business (Marketing API) ----------
# https://business-api.tiktok.com/portal/apps
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---------- LinkedIn Marketing API ----------
# https://www.linkedin.com/developers/apps -> request "Advertising API" product
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510

# ---------- Pinterest API v5 ----------
# https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
